{
  "name": "spring-inventory",
  "productName": "弹簧厂出入库管理系统",
  "description": "弹簧厂出入库管理系统 - 库存管理、入库出库、仓库区域、数据看板",
  "author": "spring-factory",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "start": "cd server && npm start",
    "generate:icon": "node scripts/generate-icon.js",
    "desktop:start": "electron .",
    "build:desktop": "npm run build:client && electron-builder --win nsis",
    "build:desktop:publish": "npm run build:client && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "electron-updater": "^6.3.9",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  }
}
